# Production settings: cp prod.env.example prod.env on the server and fill it in (prod.env is never committed).
# Read by docker compose (image, ports) and passed to the containers (application settings).

# Image built and pushed by the CI on every version tag (git tag v1.2.0, make release)
API_IMAGE=ghcr.io/bonnienac/test_house_prediction-api
API_TAG=latest
API_PORT=8000

# MLflow server of this environment, and the model the API serves (alias set by make train --register <name> --alias production)
MLFLOW_VERSION=v3.17.0
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_MODEL_URI=models:/test_house_prediction@production
