# Staging settings: a copy of production to check a version before releasing it.
# cp staging.env.example staging.env on the server and fill it in (staging.env is never committed).

API_IMAGE=ghcr.io/bonnienac/test_house_prediction-api
API_TAG=latest
# different from prod when both run on the same server
API_PORT=8001

MLFLOW_VERSION=v3.17.0
MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_MODEL_URI=models:/test_house_prediction@staging
