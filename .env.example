# Template for .env file to copy
PROFILE=
GITHUB_TOKEN=
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# API Security
# Max upload size in bytes (default: 50MB)
API_MAX_UPLOAD_SIZE=52428800

# MLflow (empty: local SQLite store mlflow.db at the project root)
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=
# Model served by the API, e.g. models:/<name>@production (empty: models/model.joblib)
MLFLOW_MODEL_URI=
